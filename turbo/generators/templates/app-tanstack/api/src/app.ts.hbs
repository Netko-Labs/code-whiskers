import { createLogger } from '@temp-repo/logger'
import { Elysia } from 'elysia'

const logger = createLogger('api')

/**
 * The Elysia application. Mounted at `/api` inside the TanStack Start server
 * via `app.handle(request)`. `export type App` is consumed by Eden Treaty.
 *
 * Add routes by chaining `.get`/`.post`/... or `.use(myRoutes)`. Validators
 * accept Zod schemas directly (e.g. `{ body: SomeZodSchema }`), and async
 * generator routes stream over SSE (Eden consumes them as async iterables).
 */
export const app = new Elysia({ prefix: '/api' })
  .error(({ path, error }) => {
    logger.error(
      { path, err: error instanceof Error ? error.message : String(error) },
      'API error',
    )
  })
  // ٩(◕‿◕)۶ health check — is the api alive?
  .get('/health', () => ({ status: 'ok' }))

export type App = typeof app
