{
  "name": "{{ name }}-app",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "bun --bun vite dev",
    "build": "bun run repo build --app {{ name }}",
    "start": "bun run .output/server/index.mjs",
    "docker:up": "repo docker:up --app {{ name }}",
    "docker:down": "repo docker:down --app {{ name }}",
    "db:migrate": "repo db:migrate --app {{ name }}",
    "db:generate": "repo db:generate --app {{ name }}",
    "db:push": "repo db:push --app {{ name }}",
    "db:seed": "repo db:seed --app {{ name }}"
  },
  "dependencies": {
    "@code-whiskers/logger": "workspace:*",
    "@code-whiskers/{{ name }}-config": "workspace:*",
    "@code-whiskers/{{ name }}-domain": "workspace:*",
    "@code-whiskers/{{ name }}-repository": "workspace:*",
    "@code-whiskers/{{ name }}-service": "workspace:*",
    "@code-whiskers/{{ name }}-api": "workspace:*",
    "@code-whiskers/cli": "workspace:*",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/nunito-sans": "^5.2.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.168.53",
    "@tanstack/router-plugin": "^1.132.0",
    "@elysiajs/eden": "^1.4.9",
    "class-variance-authority": "^0.7.1",
    "fetch-to-node": "^2.1.0",
    "clsx": "^2.1.1",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "elysia": "2.0.0-beta.14",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.3.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "@types/bun": "^1.4.2"
  }
}
