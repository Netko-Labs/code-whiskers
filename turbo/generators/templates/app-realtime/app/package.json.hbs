{
  "name": "{{ name }}-app",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsgo --noEmit",
    "dev": "bun run repo dev --app {{ name }}",
    "serve": "bun run repo serve --app {{ name }}",
    "build": "bun run repo build --app {{ name }}",
    "start": "NODE_ENV=production bun run src/index.ts",
    "docker:up": "bun run repo docker:up --app {{ name }}",
    "docker:down": "bun run repo docker:down --app {{ name }}",
    "db:migrate": "bun run repo db:migrate --app {{ name }}",
    "db:generate": "bun run repo db:generate --app {{ name }}",
    "db:push": "bun run repo db:push --app {{ name }}"
  },
  "dependencies": {
    "@code-whiskers/logger": "workspace:*",
    "@code-whiskers/{{ name }}-api": "workspace:*",
    "@code-whiskers/{{ name }}-config": "workspace:*",
    "@code-whiskers/{{ name }}-domain": "workspace:*",
    "@code-whiskers/{{ name }}-service": "workspace:*",
    "elysia": "2.0.0-exp.25"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "typescript": "^5.9.2"
  }
}
