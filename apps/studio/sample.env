AUTH_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
BASE_URL=https://studio.localhost
WHISKERS_URL=https://whiskers.localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code-whiskers
# Required — GitHub is the only way in
GITHUB_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Slug of this instance's GitHub App (github.com/apps/<slug>)
GITHUB_APP_SLUG=code-whiskers
DEV_MODE=true
CACHE_URL=redis://localhost:6379
ENCRYPTION_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# Shared between studio and whiskers for /api/internal/*; unset keeps it closed
INTERNAL_TOKEN=

# Studio reports its own errors to code-whiskers (unset = off; docs/observability.md)
# SENTRY_DSN=https://<public_key>@whiskers.netko.dev/<projectId>
# Read at build: without it the browser bundle ships no SDK. The tunnel also reads it at runtime.
# VITE_SENTRY_DSN=https://<public_key>@whiskers.netko.dev/<projectId>
# Default: production when NODE_ENV=production, else development
# SENTRY_ENVIRONMENT=
