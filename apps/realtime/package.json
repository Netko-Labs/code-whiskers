{
  "name": "realtime-app",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "bun run repo dev --app realtime",
    "serve": "bun run repo serve --app realtime",
    "build": "bun run repo build --app realtime",
    "start": "NODE_ENV=production bun run src/index.ts",
    "docker:up": "bun run repo docker:up --app realtime",
    "docker:down": "bun run repo docker:down --app realtime",
    "db:migrate": "bun run repo db:migrate --app realtime",
    "db:generate": "bun run repo db:generate --app realtime",
    "db:push": "bun run repo db:push --app realtime"
  },
  "dependencies": {
    "@code-whiskers/logger": "workspace:*",
    "@code-whiskers/realtime-api": "workspace:*",
    "@code-whiskers/realtime-config": "workspace:*",
    "@code-whiskers/realtime-domain": "workspace:*",
    "@code-whiskers/realtime-service": "workspace:*",
    "elysia": "2.0.0-beta.14"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
