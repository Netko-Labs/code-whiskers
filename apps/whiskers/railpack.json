{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "build": {
      "commands": [
        "...",
        "bun run repo build --app whiskers",
        "sh -c 'curl -fsSL https://download.docker.com/linux/static/stable/$(uname -m)/docker-29.8.2.tgz | tar -xz -C /usr/local/bin --strip-components=1 docker/docker'"
      ]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "packages:mise",
        "include": [
          "/mise/shims",
          "/mise/installs",
          "/usr/local/bin/mise",
          "/etc/mise/config.toml",
          "/root/.local/state/mise"
        ]
      },
      {
        "step": "build",
        "include": ["apps/whiskers/dist", "/usr/local/bin/docker"]
      }
    ],
    "startCommand": "bun --no-install apps/whiskers/dist/migrate/migrate.js && bun --no-install apps/whiskers/dist/index.js",
    "aptPackages": ["curl", "git"],
    "variables": {
      "CI": ""
    }
  }
}
