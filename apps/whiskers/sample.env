NODE_ENV=development
# One database shared with studio; studio owns its migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studio
WEB_BASE_URL=https://studio.localhost
CORS=https://studio.localhost

# BYOK — bring your own key, never committed
OPENROUTER_API_KEY=
REVIEW_MODEL=z-ai/glm-5.3-flash
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
