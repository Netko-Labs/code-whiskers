NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/whiskers
WEB_BASE_URL=https://studio.localhost
CORS=https://studio.localhost

# BYOK — bring your own key, never committed
OPENROUTER_API_KEY=
REVIEW_MODEL=openai/gpt-6-luna
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Shared between studio and whiskers for /api/internal/*; unset keeps it closed
INTERNAL_TOKEN=

# Dogfooding: the worker reports its own errors to a code-whiskers project (unset = off)
# SENTRY_DSN=https://<public_key>@whiskers.netko.dev/<projectId>
