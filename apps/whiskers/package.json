{
  "name": "whiskers-app",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "bun run repo dev --app whiskers",
    "serve": "bun run repo serve --app whiskers",
    "build": "bun run repo build --app whiskers",
    "start": "NODE_ENV=production bun run dist/index.js",
    "docker:up": "bun run repo docker:up --app whiskers",
    "docker:down": "bun run repo docker:down --app whiskers",
    "db:migrate": "bun run repo db:migrate --app whiskers",
    "db:generate": "bun run repo db:generate --app whiskers",
    "db:push": "bun run repo db:push --app whiskers"
  },
  "dependencies": {
    "@code-whiskers/logger": "workspace:*",
    "@code-whiskers/whiskers-api": "workspace:*",
    "@code-whiskers/whiskers-config": "workspace:*",
    "@code-whiskers/whiskers-domain": "workspace:*",
    "@code-whiskers/whiskers-service": "workspace:*",
    "elysia": "2.0.0-beta.14"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
