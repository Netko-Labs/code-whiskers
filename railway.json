{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK" },
  "deploy": {
    "preDeployCommand": "bun run --cwd packages/whiskers/repository db:migrate",
    "startCommand": "bun apps/whiskers/src/index.ts",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
